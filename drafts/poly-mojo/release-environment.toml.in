# Template only: replace @POLY_MOJO_VERSION@ with the published, verified release.
# Place the completed file at generate/polymojo/environment/pixi.toml, generate
# pixi.lock, and commit both to the contribution before submission.
[workspace]
name = "groebner-polymojo-benchmarks"
channels = ["https://conda.modular.com/max", "https://repo.prefix.dev/modular-community", "conda-forge"]
platforms = ["linux-64"]

[dependencies]
mojo = "==1.2.0"
python = "3.12.*"
poly_mojo = "==@POLY_MOJO_VERSION@"

[tasks]
build-driver = "python ../build.py"
